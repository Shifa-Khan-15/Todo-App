<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todo List</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Authentication Section -->
  <div id="auth-section" class="container">
    <div class="app-header">
      <div class="logo">
        <span class="icon-check">✓</span> TODO LIST
      </div>
      <div class="status">
        <span class="status-dot"></span> Personal Workspace
      </div>
    </div>

    <div class="hero-section">
      <p class="subtitle">A LITTLE ROOM TO THINK</p>
      <h1>Make today<br>a little lighter.</h1>
      <p>Create an account or log in to manage your personal tasks.</p>
    </div>

    <div class="list-card">
      <h2 id="auth-title">Create your account</h2>

      <form id="auth-form">
        <div class="input-wrapper">
          <input
            type="email"
            id="auth-email"
            placeholder="Email address"
            autocomplete="email"
            required
          >
        </div>

        <div class="input-wrapper">
          <input
            type="password"
            id="auth-password"
            placeholder="Password (at least 8 characters)"
            autocomplete="new-password"
            minlength="8"
            required
          >
        </div>

        <button type="submit" class="btn-add" id="auth-submit">
          Sign Up
        </button>

        <p id="auth-status" role="status"></p>
      </form>

      <p id="auth-switch-text">
        Already have an account?
        <button type="button" id="auth-switch">Log In</button>
      </p>
    </div>

    <div class="app-footer">
      ♡ Just for you, and whatever today brings
    </div>
  </div>

  <!-- Existing Todo App -->
  <div class="container" id="app-section" hidden>
    <div class="app-header">
      <div class="logo">
        <span class="icon-check">✓</span> TODO LIST
      </div>
      <div class="status">
        <span class="status-dot"></span> Connected
      </div>
    </div>

    <div class="hero-section">
      <p class="subtitle">A LITTLE ROOM TO THINK</p>
      <h1>Make today<br>a little lighter.</h1>
      <div class="hero-footer">
        <div class="date-badge">
          <span class="today-label">TODAY IS</span>
          <span class="current-date" id="date-display"></span>
        </div>
      </div>
    </div>

    <form id="todo-form" class="todo-input-group">
      <div class="input-wrapper">
        <span class="plus-icon">
          <svg width="17" height="17" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <input type="text" id="todo-input"
          placeholder="What would you like to get done?" required>
      </div>
      <button type="submit" class="btn-add">Add Task</button>
    </form>

    <div class="list-card">
      <div class="list-header">
        <h2>Your list
          <span class="count-badge" id="todo-count">0 left</span>
        </h2>

        <div class="filter-tabs">
          <button type="button" class="tab-btn active">All</button>
          <button type="button" class="tab-btn">To do</button>
          <button type="button" class="tab-btn">Done</button>
        </div>
      </div>

      <ul id="todo-list"></ul>

      <div class="list-footer">
        <div class="footer-status">
          <span class="save-status">Your list is up to date</span>
        </div>
        <div class="footer-quote">A clear list, a clearer mind.</div>
      </div>
    </div>

<!-- AI Task Breakdown -->
<div class="list-card" style="margin-top: 24px;">
  <div class="list-header">
    <h2>AI Task Breakdown</h2>
  </div>
  
  <div style="padding: 16px 23px 20px;">
    <p style="margin: 0 0 16px; color: var(--muted); font-size: 13px;">Turn a big task into smaller, manageable steps.</p>

    <div style="margin-bottom: 14px;">
      <input type="text" id="ai-task-input" placeholder="Enter a task to break down...">
    </div>
    
    <button type="button" id="ai-breakdown-btn">Break Down with AI</button>

    <p id="ai-status" role="status"></p>
    <ul id="ai-subtasks"></ul>
  </div>
</div>

    <div class="app-footer">
      ♡ Just for you, and whatever today brings
      <button type="button" id="logout-btn">Log Out</button>
    </div>
  </div>

  <script src="app.js"></script>
  <script>
    const dateDisplay = document.getElementById('date-display');
    if (dateDisplay) {
      dateDisplay.innerText = new Date().toLocaleDateString(
        'en-US',
        { weekday: 'long', day: 'numeric', month: 'long' }
      );
    }
  </script>
  <script src="auth.js"></script>
</body>
</html>
